<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/scanner_background</item>
        <item name="android:colorAccent">@color/scanner_accent</item>
        <item name="android:navigationBarColor">@color/scanner_background</item>
        <item name="android:statusBarColor">@color/scanner_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ScannerHudIconButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/scanner_control_button</item>
        <item name="android:tint">@color/scanner_text</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ScannerToolbarIconButton" parent="ScannerHudIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="ScannerPrimaryButton">
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/scanner_primary_button</item>
        <item name="android:textColor">@color/scanner_background</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="ScannerToolbarText">
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/scanner_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/scanner_toolbar_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
    </style>
</resources>
