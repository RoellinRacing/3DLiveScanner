<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="#E62A4A48" />
            <stroke android:width="1dp" android:color="@color/scanner_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/scanner_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/scanner_border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/scanner_surface" />
            <stroke android:width="1dp" android:color="@color/scanner_border" />
        </shape>
    </item>
</selector>
