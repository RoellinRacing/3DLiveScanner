<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/scanner_surface_pressed" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/scanner_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/scanner_background_raised" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/scanner_border" />
        </shape>
    </item>
</selector>
