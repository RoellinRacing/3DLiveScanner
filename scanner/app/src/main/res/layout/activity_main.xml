<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scanner_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.lvonasek.gles.GLESSurfaceView
        android:id="@+id/gl_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/ar_hand_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone">

        <com.lvonasek.arcore3dscanner.main.HandMotionView
            android:id="@+id/ar_hand_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foregroundGravity="center"
            android:scaleType="center"
            android:src="@drawable/ic_hand_phone" />
    </FrameLayout>

    <com.lvonasek.arcore3dscanner.main.DistanceMeasuring
        android:id="@+id/distance"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include layout="@layout/view_editor" />

    <LinearLayout
        android:id="@+id/layout_info"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/scanner_glass_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <View
            android:id="@+id/scan_status_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/scanner_status_good" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ic_memory" />

        <TextView
            android:id="@+id/info_left"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:minWidth="58dp"
            android:paddingStart="5dp"
            android:textColor="@color/scanner_text"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/scanner_border" />

        <TextView
            android:id="@+id/info_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:minWidth="38dp"
            android:textColor="@color/scanner_text"
            android:textSize="13sp" />

        <View
            android:id="@+id/info_battery"
            android:layout_width="42dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/ic_battery_0" />
    </LinearLayout>

    <TextView
        android:id="@+id/infolog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginTop="74dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/scanner_glass_panel"
        android:gravity="center"
        android:maxWidth="340dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/scanner_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_quickmenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="116dp"
        android:background="@drawable/scanner_glass_panel"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/photo_mode"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:buttonTint="@color/scanner_accent"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="12dp"
            android:text="@string/photo_mode"
            android:textColor="@color/scanner_text" />

        <CheckBox
            android:id="@+id/show_normals"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:buttonTint="@color/scanner_accent"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="12dp"
            android:text="@string/show_normals"
            android:textColor="@color/scanner_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_rec"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="bottom"
        android:background="@color/scanner_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/undo_button"
            style="@style/ScannerHudIconButton"
            android:contentDescription="@string/editor_edit_undo"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/clear_button"
            style="@style/ScannerHudIconButton"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/toggle_button"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="@drawable/scanner_record_button"
            android:contentDescription="@string/capture"
            android:padding="21dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause"
            android:stateListAnimator="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/view_button"
            style="@style/ScannerHudIconButton"
            android:contentDescription="@string/scan_parameters"
            android:src="@drawable/ic_arrow_up" />

        <ImageButton
            android:id="@+id/save_button"
            style="@style/ScannerHudIconButton"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/saving"
            android:src="@drawable/ic_save" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_view"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/scanner_glass_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/orbit_button"
            style="@style/ScannerToolbarIconButton"
            android:background="@drawable/scanner_toolbar_button"
            android:src="@drawable/ic_modeorbit" />

        <ImageButton
            android:id="@+id/topview_button"
            style="@style/ScannerToolbarIconButton"
            android:background="@drawable/scanner_toolbar_button"
            android:src="@drawable/ic_mode2d" />

        <ImageButton
            android:id="@+id/first_button"
            style="@style/ScannerToolbarIconButton"
            android:background="@drawable/scanner_toolbar_button"
            android:src="@drawable/ic_mode3d" />

        <ImageButton
            android:id="@+id/cardboard_button"
            style="@style/ScannerToolbarIconButton"
            android:background="@drawable/scanner_toolbar_button"
            android:src="@drawable/ic_cardboard"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/measure_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:background="@drawable/scanner_glass_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/measure_toggle"
            style="@style/ScannerToolbarIconButton"
            android:background="@drawable/scanner_toolbar_button"
            android:contentDescription="@string/measure"
            android:src="@drawable/ic_measure" />

        <ImageButton
            android:id="@+id/measure_undo"
            style="@style/ScannerToolbarIconButton"
            android:background="@drawable/scanner_toolbar_button"
            android:contentDescription="@string/measure_undo"
            android:src="@drawable/ic_measure_undo" />

        <ImageButton
            android:id="@+id/measure_clear"
            style="@style/ScannerToolbarIconButton"
            android:background="@drawable/scanner_toolbar_button"
            android:contentDescription="@string/measure_clear"
            android:src="@drawable/ic_measure_clear" />

        <ImageButton
            android:id="@+id/measure_scale"
            style="@style/ScannerToolbarIconButton"
            android:background="@drawable/scanner_toolbar_button"
            android:contentDescription="@string/measure_scale"
            android:src="@drawable/ic_measure_scale" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_undo"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@color/scanner_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <Button android:id="@+id/undo_back_fast" style="@style/ScannerToolbarText" android:layout_width="48dp" android:text="«" />
        <Button android:id="@+id/undo_back" style="@style/ScannerToolbarText" android:layout_width="48dp" android:text="‹" />
        <Button android:id="@+id/undo_fwd" style="@style/ScannerToolbarText" android:layout_width="48dp" android:text="›" />
        <Button android:id="@+id/undo_fwd_fast" style="@style/ScannerToolbarText" android:layout_width="48dp" android:text="»" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/undo_cancel" style="@style/ScannerToolbarText" android:layout_width="92dp" android:text="@android:string/cancel" />
        <Button android:id="@+id/undo_apply" style="@style/ScannerToolbarText" android:layout_width="92dp" android:layout_marginStart="6dp" android:text="@android:string/ok" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_wait"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@color/scanner_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="@color/scanner_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/wait"
            android:textColor="@color/scanner_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/scanner_accent"
        android:visibility="gone" />

    <Button
        android:id="@+id/editor_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="76dp"
        android:background="@drawable/scanner_button_editor"
        android:stateListAnimator="@null"
        android:visibility="gone" />

    <Button
        android:id="@+id/thumbnail_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/scanner_button_thumbnail"
        android:stateListAnimator="@null"
        android:visibility="gone" />
</FrameLayout>
