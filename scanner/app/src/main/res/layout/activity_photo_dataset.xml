<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scanner_background">

    <TextureView
        android:id="@+id/photo_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/scanner_scrim"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/photo_scan_title"
            android:textColor="@color/scanner_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/photo_scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/photo_scan_initializing"
            android:textColor="@color/scanner_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scanner_scrim"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/photo_scan_instruction"
            android:textColor="@color/scanner_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/photo_scan_auto"
                style="@style/ScannerToolbarText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/photo_scan_auto_start" />

            <Button
                android:id="@+id/photo_scan_capture"
                style="@style/ScannerPrimaryButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1.2"
                android:text="@string/photo_scan_capture" />

            <Button
                android:id="@+id/photo_scan_finish"
                style="@style/ScannerToolbarText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/photo_scan_finish" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
