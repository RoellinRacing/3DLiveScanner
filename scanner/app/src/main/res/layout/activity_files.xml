<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_menu">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentTop="true"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/settings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_centerVertical="true"
            android:background="@drawable/scanner_button_settings"
            android:contentDescription="@string/settings"
            android:stateListAnimator="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/settings"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/scanner_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="3D MODELING STUDIO"
                android:textColor="@color/scanner_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/options"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentTop="true"
        android:background="@color/scanner_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/scanner_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/position"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/scanner_button_position"
            android:visibility="gone"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/scanner_button_share"
            android:contentDescription="@string/share_via"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/rename"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/scanner_button_rename"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/scanner_button_delete"
            android:contentDescription="@string/delete"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header"
        android:background="@color/scanner_border" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/scanner_glass_panel"
            android:contentDescription="@string/app_name"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_model_icon" />

        <TextView
            android:id="@+id/info_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/no_data"
            android:textAlignment="center"
            android:textColor="@color/scanner_text_secondary"
            android:textSize="18sp"
            android:lineSpacingExtra="4dp" />

        <CheckBox
            android:id="@+id/checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:buttonTint="@color/scanner_accent"
            android:text="@string/policy_accepted"
            android:textColor="@color/scanner_text"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/service_cancel"
            style="@style/ScannerToolbarText"
            android:layout_width="220dp"
            android:text="@string/action_cancel" />
    </LinearLayout>

    <GridView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/layout_menu_action"
        android:clipToPadding="false"
        android:horizontalSpacing="10dp"
        android:numColumns="3"
        android:padding="12dp"
        android:scrollbarStyle="outsideOverlay"
        android:verticalSpacing="12dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/scanner_accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_menu_action"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_alignParentBottom="true"
        android:background="@color/scanner_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/add_button"
            style="@style/ScannerPrimaryButton"
            android:layout_width="match_parent"
            android:text="@string/capture" />
    </LinearLayout>
</RelativeLayout>
